{
  "info": {
    "_postman_id": "12ee2eb4-72f5-4d1d-bf7f-2c89ec5a1a7a",
    "name": "Construct Backend - Geo Attendance and Worklist",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Endpoints for geo attendance sessions, daily worklist, and admin analytics."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get('access_token');",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}",
          "if (!pm.environment.get('date_today')) {",
          "  pm.environment.set('date_today', new Date().toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "admin_user_id",
      "value": ""
    },
    {
      "key": "project_id",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "work_item_id",
      "value": ""
    },
    {
      "key": "date_today",
      "value": ""
    },
    {
      "key": "start_date",
      "value": ""
    },
    {
      "key": "end_date",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"worker_demo\",\n  \"email\": \"worker_demo@example.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"Worker\",\n  \"last_name\": \"Demo\",\n  \"account_type\": \"technical\",\n  \"grade\": \"tech_wk\",\n  \"employee_id\": \"EMP-DEMO-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/signup/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"worker_demo\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/login/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Store JWT tokens', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('access');",
                  "  pm.expect(body).to.have.property('refresh');",
                  "  pm.expect(body).to.have.property('user');",
                  "  pm.environment.set('access_token', body.access);",
                  "  pm.environment.set('refresh_token', body.refresh);",
                  "  pm.environment.set('user_id', String(body.user.id));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Attendance Sessions",
      "item": [
        {
          "name": "Check In (Site)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project\": {{project_id}},\n  \"location_type\": \"site\",\n  \"check_in_latitude\": 12.9716,\n  \"check_in_longitude\": 77.5946,\n  \"check_in_address\": \"Site Gate A\",\n  \"travel_km\": \"0.00\",\n  \"notes\": \"Morning site check-in\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/attendance-sessions/check-in/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Check-in status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Save session id from check-in', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.environment.set('session_id', String(body.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My Open Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/attendance-sessions/my-open-session/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Open session status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Out",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"check_out_latitude\": 12.9721,\n  \"check_out_longitude\": 77.5951,\n  \"check_out_address\": \"Site Exit A\",\n  \"notes\": \"Checkout completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/auth/attendance-sessions/{{session_id}}/check-out/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Check-out status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Session is now closed', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('closed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My Day Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/attendance-sessions/my-day-summary/?date={{date_today}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Summary status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Summary includes totals', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('total_sessions');",
                  "  pm.expect(body).to.have.property('total_distance_km');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Daily Worklist",
